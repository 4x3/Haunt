# Copy to .env and fill in. Never commit the real .env.

# Discord bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Discord application ID: Developer Portal > your app > General Information
CLIENT_ID=

# Hypixel API key. Note this is no longer the in-game /api command - register an
# application at https://developer.hypixel.net and copy the key from there.
HYPIXEL_API_KEY=

# Optional. Set to a server ID to register commands there instantly while
# developing; leave blank to register globally.
GUILD_ID=
